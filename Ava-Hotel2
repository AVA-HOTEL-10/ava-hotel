        &lt;div class="field"&gt;&lt;label&gt;Pago Dividido&lt;/label&gt;&lt;label class="pill" style="justify-content:center"&gt;&lt;input id="invoiceSplit" type="checkbox" style="width:auto" /&gt; Activar segundo pago&lt;/label&gt;&lt;/div&gt;
        &lt;div class="field split-invoice hidden"&gt;&lt;label&gt;Segundo método&lt;/label&gt;&lt;select id="invoicePayment2"&gt;${PAYMENT_METHODS.map(p=&gt;`&lt;option&gt;${p}&lt;/option&gt;`).join('')}&lt;/select&gt;&lt;/div&gt;
        &lt;div class="field split-invoice hidden"&gt;&lt;label&gt;Monto segundo método&lt;/label&gt;&lt;input id="invoiceReceived2" type="number" min="0" step="0.01" /&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Fecha y Hora&lt;/label&gt;&lt;input class="live-now" readonly /&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Valor a Devolver / Pendiente&lt;/label&gt;&lt;input id="invoiceChange" readonly /&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px"&gt;
        &lt;button id="addInvoiceItem" class="btn btn-primary" type="button"&gt;&lt;i data-lucide="plus"&gt;&lt;/i&gt; Agregar ítem&lt;/button&gt;
        &lt;button id="saveInvoice" class="btn btn-success" type="button"&gt;&lt;i data-lucide="save"&gt;&lt;/i&gt; Guardar venta&lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="totalizer"&gt;&lt;span&gt;Total venta&lt;/span&gt;&lt;strong id="invoiceTotal"&gt;${money(0)}&lt;/strong&gt;&lt;/div&gt;
    &lt;div class="card"&gt;&lt;div id="invoiceItemsTable"&gt;&lt;/div&gt;&lt;/div&gt;
  `);
  setupLiveClock($('#content'));

  let selectedClient = { nombre:'General', id:null };
  let selectedProduct = null;

  function mergeInvoiceProducts() {
    products = inventoryProducts.map(x =&gt; ({
      ...x, nombre: x.descripcion, pvp: safeNumber(productPvpMap[x.id]?.pvp), costoUnitario: safeNumber(x.costoUnitario)
    }));
  }

  function saleTotal() { return items.reduce((s,it)=&gt;s + safeNumber(it.total), 0); }
  function updateMoneyFields() {
    const qty = safeNumber($('#invoiceQty').value);
    const pvp = safeNumber($('#invoicePvp').value);
    $('#invoiceItemTotal').value = qty &gt; 0 &amp;&amp; pvp &gt;= 0 ? (qty*pvp).toFixed(2) : '';
    const received1Raw = $('#invoiceReceived1').value;
    const received1 = received1Raw === '' ? 0 : safeNumber(received1Raw);
    const received2 = $('#invoiceSplit').checked ? safeNumber($('#invoiceReceived2').value) : 0;
    const diff = received1 + received2 - saleTotal();
    $('#invoiceChange').value = diff &gt;= 0 ? `Devuelve ${money(diff)}` : `Pendiente ${money(Math.abs(diff))}`;
  }
  ['invoiceQty','invoiceReceived1','invoiceReceived2'].forEach(id =&gt; $('#' + id).addEventListener('input', updateMoneyFields));
  $('#invoiceSplit').addEventListener('change', () =&gt; { $$('.split-invoice').forEach(el=&gt;el.classList.toggle('hidden', !$('#invoiceSplit').checked)); updateMoneyFields(); });

  function renderItems() {
    $('#invoiceTotal').textContent = money(saleTotal());
    updateMoneyFields();
    if (!items.length) { $('#invoiceItemsTable').innerHTML = emptyState('Agrega productos a la factura.'); initIcons(); return; }
    $('#invoiceItemsTable').innerHTML = `&lt;div class="table-wrap"&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Producto&lt;/th&gt;&lt;th&gt;Cantidad&lt;/th&gt;&lt;th&gt;PVP&lt;/th&gt;&lt;th&gt;Total&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
      ${items.map((it,idx)=&gt;`&lt;tr&gt;&lt;td&gt;${escapeHtml(it.descripcion)}&lt;/td&gt;&lt;td&gt;${it.cantidad}&lt;/td&gt;&lt;td&gt;${money(it.pvpUnitario)}&lt;/td&gt;&lt;td class="amount"&gt;${money(it.total)}&lt;/td&gt;&lt;td&gt;&lt;button class="btn btn-danger btn-sm" data-remove-invoice-item="${idx}" type="button"&gt;&lt;i data-lucide="trash-2"&gt;&lt;/i&gt; Eliminar&lt;/button&gt;&lt;/td&gt;&lt;/tr&gt;`).join('')}
    &lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;`;
    $$('[data-remove-invoice-item]').forEach(btn =&gt; btn.addEventListener('click', () =&gt; { items.splice(Number(btn.dataset.removeInvoiceItem),1); renderItems(); }));
    initIcons();
  }
  function clearProductForm() { selectedProduct=null; $('#invoiceProduct').value=''; $('#invoiceQty').value=''; $('#invoicePvp').value=''; $('#invoiceItemTotal').value=''; }

  bindAutocomplete($('#invoiceClient'), $('#clientSuggest'), () =&gt; clients, x =&gt; x.nombre || '', c =&gt; { selectedClient = c; $('#invoiceClient').value = c.nombre; });
  bindAutocomplete($('#invoiceProduct'), $('#productSuggest'), () =&gt; products, x =&gt; x.descripcion || x.nombre || '', p =&gt; {
    selectedProduct = p;
    $('#invoiceProduct').value = p.descripcion || p.nombre;
    $('#invoicePvp').value = safeNumber(p.pvp).toFixed(2);
    updateMoneyFields();
  });

  $('#addInvoiceItem').addEventListener('click', () =&gt; {
    const desc = $('#invoiceProduct').value.trim();
    const p = selectedProduct || products.find(x =&gt; (x.descripcion || x.nombre || '').toLowerCase() === desc.toLowerCase());
    const qty = safeNumber($('#invoiceQty').value);
    const pvp = safeNumber($('#invoicePvp').value);
    if (!p || !desc || qty &lt;= 0 || pvp &lt;= 0) { toast('Selecciona producto, cantidad y PVP válido.', 'error'); return; }
    items.push({
      productId: p.id, descripcion: p.descripcion || p.nombre, cantidad: qty,
      pvpUnitario: pvp, costoUnitario: safeNumber(p.costoUnitario), total: qty * pvp,
      tipoProducto: 'Producto Venta'
    });
    clearProductForm();
    renderItems();
  });

  $('#saveInvoice').addEventListener('click', async () =&gt; {
    if (!items.length) { toast('No hay ítems para guardar.', 'error'); return; }
    try {
      const total = saleTotal();
      const received1Empty = $('#invoiceReceived1').value === '';
      const amount1 = received1Empty ? 0 : safeNumber($('#invoiceReceived1').value);
      const amount2 = $('#invoiceSplit').checked ? safeNumber($('#invoiceReceived2').value) : 0;
      const totalReceived = amount1 + amount2;
      const paid = Math.min(totalReceived, total);
      const debt = Math.max(total - totalReceived, 0);
      const payments = getPaymentDistribution($('#invoicePayment1').value, amount1, $('#invoiceSplit').checked, $('#invoicePayment2').value, amount2);
      const clienteNombre = $('#invoiceClient').value.trim() || 'General';
      const facturaNumero = nextInvoice;
      const batch = db.batch();
      const invoiceRef = db.collection('facturas').doc();

      batch.set(invoiceRef, {
        facturaNumero, clienteNombre, clienteId: selectedClient?.id || null, items,
        totalFactura: total, totalRecibido: totalReceived, totalPagado: paid, saldoPendiente: debt,
        formaPago: $('#invoicePayment1').value, pagoDividido: $('#invoiceSplit').checked, pagos: payments,
        fecha: serverNow(), createdAt: serverNow(), creadoPor: currentUser.email
      });

      items.forEach(it =&gt; {
        const invRef = db.collection('inventario').doc(it.productId);
        batch.set(invRef, { stock: FV.increment(-safeNumber(it.cantidad)), updatedAt: serverNow() }, { merge:true });
      });

      if (paid &gt; 0) {
        const saleRef = db.collection('ventas').doc();
        batch.set(saleRef, {
          facturaNumero, facturaId: invoiceRef.id, clienteNombre, clienteId: selectedClient?.id || null, items,
          totalFactura: total, totalPagado: paid, valor: paid, saldoPendiente: debt,
          formaPago: $('#invoicePayment1').value, pagoDividido: $('#invoiceSplit').checked, pagos: payments,
          fecha: serverNow(), createdAt: serverNow(), origen:'facturacion', creadoPor: currentUser.email
        });
      }
      if (debt &gt; 0 || totalReceived &lt;= 0) {
        const debtRef = db.collection('cartera').doc();
        batch.set(debtRef, {
          clienteNombre, clienteId: selectedClient?.id || null, cedula: selectedClient?.cedula || '',
          descripcion: items.map(i =&gt; `${i.descripcion} x${i.cantidad}`).join(', '),
          valorPendiente: debt &gt; 0 ? debt : total, valorOriginal: total, origen:'facturacion', facturaNumero, facturaId: invoiceRef.id,
          items, fecha: serverNow(), createdAt: serverNow()
        });
      }
      await batch.commit();
      toast('Venta registrada');
      items = []; selectedClient = { nombre:'General', id:null };
      $('#invoiceClient').value='General'; $('#invoiceReceived1').value=''; $('#invoiceReceived2').value=''; $('#invoiceSplit').checked=false; $$('.split-invoice').forEach(el=&gt;el.classList.add('hidden'));
      renderItems();
    } catch(err) { showError(err, 'No fue posible guardar la venta'); }
  });

  addUnsub(db.collection('clientes').onSnapshot(snap =&gt; { clients = snap.docs.map(doc =&gt; ({id:doc.id,...doc.data()})); }));
  addUnsub(db.collection('facturas').onSnapshot(snap =&gt; {
    const nums = snap.docs.map(d =&gt; safeNumber(d.data().facturaNumero));
    nextInvoice = (nums.length ? Math.max(...nums) : 0) + 1;
