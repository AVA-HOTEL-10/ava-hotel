      &lt;div class="grid grid-2" style="margin-bottom:16px"&gt;
        &lt;div class="card" style="box-shadow:none"&gt;&lt;span class="muted"&gt;Stock total&lt;/span&gt;&lt;h3&gt;${totalStock}&lt;/h3&gt;&lt;/div&gt;
        &lt;div class="card" style="box-shadow:none"&gt;&lt;span class="muted"&gt;Valor inventario&lt;/span&gt;&lt;h3&gt;${money(totalValue)}&lt;/h3&gt;&lt;/div&gt;
      &lt;/div&gt;
      ${filteredRows.length ? `
        &lt;div class="table-wrap"&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;&lt;th&gt;Tipo de Producto&lt;/th&gt;&lt;th&gt;Descripción&lt;/th&gt;&lt;th&gt;Stock&lt;/th&gt;&lt;th&gt;Valor $&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;
        ${filteredRows.map(r=&gt;`
          &lt;tr&gt;
            &lt;td&gt;&lt;span class="pill green"&gt;${escapeHtml(r.tipoProducto)}&lt;/span&gt;&lt;/td&gt;
            &lt;td&gt;${escapeHtml(r.descripcion)}&lt;/td&gt;
            &lt;td&gt;&lt;b&gt;${safeNumber(r.stock)}&lt;/b&gt; ${escapeHtml(r.tipoUnidad || '')}&lt;/td&gt;
            &lt;td class="amount"&gt;${money(safeNumber(r.stock)*safeNumber(r.costoUnitario))}&lt;/td&gt;
            &lt;td&gt;
              &lt;div style="display:flex;gap:8px;flex-wrap:wrap"&gt;
                &lt;button class="btn btn-warning btn-sm" data-adjust-stock="${r.id}" type="button"&gt;&lt;i data-lucide="sliders-horizontal"&gt;&lt;/i&gt; Ajustar&lt;/button&gt;
                &lt;button class="btn btn-danger btn-sm" data-delete-inventory-product="${r.id}" type="button"&gt;&lt;i data-lucide="trash-2"&gt;&lt;/i&gt; Eliminar&lt;/button&gt;
              &lt;/div&gt;
            &lt;/td&gt;
          &lt;/tr&gt;`).join('')}&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;
      ` : emptyState('No hay productos que coincidan con la búsqueda.')}`;

    $$('[data-adjust-stock]').forEach(btn =&gt; btn.addEventListener('click', async () =&gt; {
      const row = inventoryRows.find(r =&gt; r.id === btn.dataset.adjustStock);
      if (!row || !confirmPassword()) { toast('Contraseña incorrecta.', 'error'); return; }
      const value = prompt(`Nuevo stock para ${row.descripcion}:`, safeNumber(row.stock));
      if (value === null) return;
      const stock = safeNumber(value);
      try {
        await db.collection('inventario').doc(row.id).set({ stock, updatedAt: serverNow() }, { merge:true });
        toast('Inventario ajustado');
      } catch(err) { showError(err, 'No fue posible ajustar'); }
    }));

    // MEJORA #3
    $$('[data-delete-inventory-product]').forEach(btn =&gt; btn.addEventListener('click', async () =&gt; {
      const row = inventoryRows.find(r =&gt; r.id === btn.dataset.deleteInventoryProduct);
