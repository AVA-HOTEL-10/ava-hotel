async function openRoomPanel(room) {
  const stay = room.estadiaActiva || {};

  // MEJORA ACOMPAÑANTES
  const acompanantes = (Array.isArray(stay.acompanantes) ? stay.acompanantes : [])
    .map(item =&gt; ({
      nombreCompleto: String(item?.nombreCompleto || item?.nombre || '').trim(),
      cedula: String(item?.cedula || '').trim()
    }))
    .filter(item =&gt; item.nombreCompleto || item.cedula);

  let services = [];

  try {
    const servicesSnap = await db.collection('servicios').get();
    // [MEJORA #2 - INICIO]
    services = servicesSnap.docs.map(doc =&gt; ({ id: doc.id, ...doc.data() }))
      .filter(service =&gt; service.requiereHabitacion !== false)
      .sort((a,b)=&gt;(a.descripcion||'').localeCompare(b.descripcion||''));
    // [MEJORA #2 - FIN]
