  }

  const serviceOptions = services.length
    ? services.map(s =&gt; `&lt;option value="${s.id}" ${s.id === stay.servicioId ? 'selected' : ''}&gt;${escapeHtml(s.descripcion)} · ${money(s.valor)}&lt;/option&gt;`).join('')
    : '&lt;option value=""&gt;No hay servicios disponibles&lt;/option&gt;';

  modal(`
    &lt;!-- MEJORA 1: encabezado con botón X para cerrar sin guardar --&gt;
    &lt;div class="room-modal-header"&gt;
      &lt;div&gt;
        &lt;h3&gt;Habitación ${escapeHtml(room.nombre)}&lt;/h3&gt;
        &lt;p class="muted"&gt;Ficha actual del huésped&lt;/p&gt;
      &lt;/div&gt;
      &lt;button class="btn btn-soft room-modal-close" id="closeRoomModalX" type="button" aria-label="Cerrar modal" title="Cerrar sin guardar"&gt;
        &lt;i data-lucide="x"&gt;&lt;/i&gt;
      &lt;/button&gt;
    &lt;/div&gt;

    &lt;!-- MEJORA 2: todo el contenido desplazable queda dentro de esta zona --&gt;
    &lt;div class="room-modal-body"&gt;
      &lt;div class="grid"&gt;
        &lt;div class="notice"&gt;
          &lt;b&gt;Nombre del cliente:&lt;/b&gt; ${escapeHtml(stay.clienteNombre || '-')}&lt;br&gt;
          &lt;b&gt;Servicio adquirido:&lt;/b&gt; ${escapeHtml(stay.servicioDescripcion || '-')}&lt;br&gt;
          &lt;b&gt;Tiempo restante:&lt;/b&gt; &lt;span id="roomModalRemaining"&gt;${escapeHtml(formatRemaining(room))}&lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      &lt;!-- // MEJORA ACOMPAÑANTES --&gt;
      ${acompanantes.length ? `
        &lt;div class="companions-panel" style="margin-top:16px"&gt;
          &lt;div class="companions-panel-head"&gt;
            &lt;div&gt;
              &lt;h4&gt;Acompañantes registrados&lt;/h4&gt;
              &lt;span class="mini"&gt;Personas asociadas a la estadía del titular.&lt;/span&gt;
            &lt;/div&gt;
            &lt;span class="pill"&gt;${acompanantes.length}&lt;/span&gt;
          &lt;/div&gt;
          &lt;div class="companions-summary-list"&gt;
            ${acompanantes.map(item =&gt; `
              &lt;div class="companion-summary-item"&gt;
                &lt;span&gt;&lt;b&gt;${escapeHtml(item.nombreCompleto || '-')}&lt;/b&gt;&lt;/span&gt;
                &lt;span class="muted"&gt;Cédula: ${escapeHtml(item.cedula || '-')}&lt;/span&gt;
              &lt;/div&gt;
            `).join('')}
          &lt;/div&gt;
        &lt;/div&gt;
      ` : ''}

      &lt;div id="renewalPanel" class="hidden" style="margin-top:16px"&gt;
        &lt;div class="notice" style="margin-bottom:14px"&gt;&lt;b&gt;Renovación de estadía&lt;/b&gt;&lt;br&gt;&lt;span class="mini"&gt;Selecciona el servicio, registra el pago y confirma para actualizar la habitación.&lt;/span&gt;&lt;/div&gt;
        &lt;div class="form-grid two"&gt;
          &lt;div class="field full"&gt;
            &lt;label&gt;Tipo de estadía a renovar&lt;/label&gt;
            &lt;select id="renewService"&gt;${serviceOptions}&lt;/select&gt;
          &lt;/div&gt;
          &lt;div class="field"&gt;&lt;label&gt;Fecha y hora&lt;/label&gt;&lt;input id="renewDateTime" class="live-now" readonly /&gt;&lt;/div&gt;
          &lt;div class="field"&gt;&lt;label&gt;Valor del servicio&lt;/label&gt;&lt;input id="renewValue" readonly /&gt;&lt;/div&gt;
          &lt;div class="field"&gt;&lt;label&gt;Forma de pago&lt;/label&gt;&lt;select id="renewPayment1"&gt;${PAYMENT_METHODS.map(p=&gt;`&lt;option&gt;${p}&lt;/option&gt;`).join('')}&lt;/select&gt;&lt;/div&gt;
          &lt;div class="field"&gt;&lt;label&gt;Monto recibido&lt;/label&gt;&lt;input id="renewReceived1" type="number" min="0" step="0.01" placeholder="Vacío = cartera" /&gt;&lt;/div&gt;
          &lt;div class="field"&gt;&lt;label&gt;Pago dividido&lt;/label&gt;&lt;label class="pill" style="justify-content:center"&gt;&lt;input id="renewSplit" type="checkbox" style="width:auto" /&gt; Activar segundo pago&lt;/label&gt;&lt;/div&gt;
          &lt;div class="field split-renew hidden"&gt;&lt;label&gt;Segundo método&lt;/label&gt;&lt;select id="renewPayment2"&gt;${PAYMENT_METHODS.map(p=&gt;`&lt;option&gt;${p}&lt;/option&gt;`).join('')}&lt;/select&gt;&lt;/div&gt;
          &lt;div class="field split-renew hidden"&gt;&lt;label&gt;Monto segundo método&lt;/label&gt;&lt;input id="renewReceived2" type="number" min="0" step="0.01" /&gt;&lt;/div&gt;
          &lt;div class="field full"&gt;&lt;label&gt;Cambio / saldo&lt;/label&gt;&lt;input id="renewChange" readonly /&gt;&lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;

    &lt;!-- MEJORA 1 y MEJORA 2: acciones fijas y siempre accesibles --&gt;
    &lt;div class="room-modal-footer"&gt;
      &lt;button class="btn btn-soft" id="closeRoomModal" type="button"&gt;&lt;i data-lucide="arrow-left"&gt;&lt;/i&gt; Regresar / Cancelar&lt;/button&gt;
      &lt;button class="btn btn-warning" id="renewStay" type="button"&gt;&lt;i data-lucide="refresh-cw"&gt;&lt;/i&gt; Renovar&lt;/button&gt;
      &lt;button class="btn btn-success hidden" id="confirmRenewal" type="button"&gt;&lt;i data-lucide="save"&gt;&lt;/i&gt; Confirmar renovación&lt;/button&gt;
      &lt;button class="btn btn-success" id="releaseRoom" type="button"&gt;&lt;i data-lucide="door-open"&gt;&lt;/i&gt; Liberar habitación&lt;/button&gt;
    &lt;/div&gt;
  `);

  // MEJORA 2: aplica el diseño con altura limitada y scroll interno solo a este modal.
  $('#modalRoot .modal')?.classList.add('room-renew-modal');
  setupLiveClock($('#modalRoot'));

  const updateRoomRemaining = () =&gt; {
    const el = $('#roomModalRemaining');
    if (el) el.textContent = formatRemaining(room);
  };
  updateRoomRemaining();
  activeIntervals.push(setInterval(updateRoomRemaining, 1000));

  const getRenewService = () =&gt; services.find(s =&gt; s.id === $('#renewService')?.value);
  const calcRenewal = () =&gt; {
    const service = getRenewService();
    const total = service ? safeNumber(service.valor) : 0;
    const received1 = $('#renewReceived1')?.value === '' ? 0 : safeNumber($('#renewReceived1')?.value);
    const received2 = $('#renewSplit')?.checked ? safeNumber($('#renewReceived2')?.value) : 0;
    const diff = received1 + received2 - total;
    if ($('#renewValue')) $('#renewValue').value = service ? total.toFixed(2) : '';
    if ($('#renewChange')) $('#renewChange').value = diff &gt;= 0 ? `Cambio ${money(diff)}` : `Saldo ${money(diff)}`;
  };

  // MEJORA 1: ambos controles cierran el modal sin ejecutar guardados ni cambios en Firestore.
  $('#closeRoomModalX').addEventListener('click', closeModal);
  $('#closeRoomModal').addEventListener('click', closeModal);

  $('#releaseRoom').addEventListener('click', async () =&gt; {
    try { await db.collection('habitaciones').doc(room.id).set({ estado:'libre', estadiaActiva: null, updatedAt: serverNow() }, {merge:true}); closeModal(); toast('Habitación liberada'); }
    catch(err) { showError(err, 'No fue posible liberar habitación'); }
  });

  $('#renewStay').addEventListener('click', () =&gt; {
    const renewalPanel = $('#renewalPanel');
    const opening = renewalPanel.classList.contains('hidden');
    renewalPanel.classList.toggle('hidden', !opening);
    $('#confirmRenewal').classList.toggle('hidden', !opening);
    $('#renewStay').innerHTML = opening
      ? '&lt;i data-lucide="chevron-up"&gt;&lt;/i&gt; Ocultar renovación'
      : '&lt;i data-lucide="refresh-cw"&gt;&lt;/i&gt; Renovar';
    initIcons();
    calcRenewal();

    if (opening) {
      requestAnimationFrame(() =&gt; renewalPanel.scrollIntoView({ behavior:'smooth', block:'start' }));
    }
  });

  $('#renewService').addEventListener('change', calcRenewal);
  ['renewReceived1','renewReceived2'].forEach(id =&gt; $('#' + id).addEventListener('input', calcRenewal));
  $('#renewSplit').addEventListener('change', () =&gt; {
    $$('.split-renew').forEach(el=&gt;el.classList.toggle('hidden', !$('#renewSplit').checked));
    calcRenewal();
  });

  $('#confirmRenewal').addEventListener('click', async () =&gt; {
    const service = getRenewService();
    if (!service) { toast('Selecciona un servicio para renovar.', 'error'); return; }

    try {
      const total = safeNumber(service.valor);
      const amount1 = $('#renewReceived1').value === '' ? 0 : safeNumber($('#renewReceived1').value);
      const amount2 = $('#renewSplit').checked ? safeNumber($('#renewReceived2').value) : 0;
      const received = amount1 + amount2;
      const paid = Math.min(received, total);
      const debt = Math.max(total - received, 0);
      const payments = getPaymentDistribution($('#renewPayment1').value, amount1, $('#renewSplit').checked, $('#renewPayment2').value, amount2);
      const exit = calculateExitDate(service, new Date());
      if (!exit) throw new Error('No fue posible calcular la hora de salida del servicio seleccionado.');

      const clienteNombre = stay.clienteNombre || 'Sin nombre';
      const cedula = stay.cedula || '';
      const batch = db.batch();
      const registroRef = db.collection('registros').doc();
      const roomRef = db.collection('habitaciones').doc(room.id);

      batch.set(registroRef, {
        tipo:'renovacion', clienteNombre, clienteId: stay.clienteId || null, cedula,
        // MEJORA ACOMPAÑANTES
        acompanantes,
        servicioId: service.id, servicioDescripcion: service.descripcion, habitacionId: room.id, habitacionNombre: room.nombre,
        valorTotal: total, valorPagado: paid, valor: paid, saldoPendiente: debt,
        formaPago: $('#renewPayment1').value, pagoDividido: $('#renewSplit').checked, pagos: payments,
        fecha: serverNow(), createdAt: serverNow(), origen:'renovacion-hospedaje', creadoPor: currentUser.email
      });

      // MEJORA ACOMPAÑANTES: Cartera conserva únicamente los datos del titular.
      if (debt &gt; 0 || received &lt;= 0) {
        const debtRef = db.collection('cartera').doc();
        batch.set(debtRef, {
          clienteNombre, clienteId: stay.clienteId || null, cedula,
          descripcion: service.descripcion, valorPendiente: debt &gt; 0 ? debt : total, valorOriginal: total,
          origen:'renovacion-hospedaje', servicioId: service.id, habitacionId: room.id, habitacionNombre: room.nombre,
          registroId: registroRef.id, fecha: serverNow(), createdAt: serverNow()
        });
      }

      batch.set(roomRef, {
        estado:'ocupada', updatedAt: serverNow(),
        estadiaActiva: {
          clienteNombre, clienteId: stay.clienteId || null, cedula, servicioId: service.id,
          // MEJORA ACOMPAÑANTES
          acompanantes,
          servicioDescripcion: service.descripcion, valor: total, checkIn: serverNow(), expiresAt: firebase.firestore.Timestamp.fromDate(exit),
          tipoTiempo: service.tipoTiempo, horas: service.horas || null, horaSalida: service.horaSalida || null,
          registroId: registroRef.id, renovadaAt: serverNow()
        }
      }, { merge:true });

      await batch.commit();
      closeModal();
      toast('Renovación registrada y habitación actualizada');
    } catch(err) { showError(err, 'No fue posible confirmar la renovación'); }
  });

  calcRenewal();
}

