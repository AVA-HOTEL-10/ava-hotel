      &lt;button class="btn btn-soft" type="button" id="resetToday"&gt;&lt;i data-lucide="calendar-days"&gt;&lt;/i&gt; Hoy&lt;/button&gt;
    &lt;/div&gt;`;
}

function bindDateFilterGuard(sectionId, onApply) {
  const today = localDateInput();
  const start = $('#filterStart');
  const end = $('#filterEnd');
  const type = $('#filterType');
  const reset = $('#resetToday');
  const apply = () =&gt; {
    const changingRange = start.value !== today || end.value !== today;
    if (changingRange &amp;&amp; !filterUnlocked[sectionId]) {
      if (!confirmPassword('filter')) {
        start.value = today;
        end.value = today;
        toast('Rango bloqueado. Contraseña incorrecta.', 'error');
      } else {
        filterUnlocked[sectionId] = true;
        toast('Filtro desbloqueado');
      }
    }
    onApply();
  };
  [start, end].forEach(el =&gt; el.addEventListener('change', apply));
  if (type) type.addEventListener('change', onApply);
  if (reset) reset.addEventListener('click', () =&gt; { start.value=today; end.value=today; onApply(); });
}

