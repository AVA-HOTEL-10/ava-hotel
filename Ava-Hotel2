    const units = ventasF.filter(v=&gt;!v.isAbono).flatMap(v=&gt;v.items || []).reduce((s,it)=&gt;s+safeNumber(it.cantidad),0);
    const invoices = new Set(ventasF.filter(v=&gt;v.facturaNumero).map(v=&gt;v.facturaNumero)).size || ventasF.length;
    const upt = invoices ? units / invoices : 0;
    const vpt = invoices ? totalVentas / invoices : 0;
    const vpu = units ? totalVentas / units : 0;

    const selectedEnd = new Date(end + 'T12:00:00');
    const day = Math.max(1, selectedEnd.getDate());
    const projection = (totalVentas / day) * daysInMonth(selectedEnd);

    const serviceMap = {};
    registrosF.forEach(r =&gt; { const key = r.servicioDescripcion || r.descripcion || 'Sin servicio'; serviceMap[key] = (serviceMap[key] || 0) + safeNumber(r.valor || r.valorPagado); });
    const topServices = Object.entries(serviceMap).sort((a,b)=&gt;b[1]-a[1]).slice(0,5);

    const productUnits = {}, productProfit = {}, productSales = {}, clientSales = {};
    ventasF.forEach(v =&gt; {
      clientSales[v.clienteNombre || 'General'] = (clientSales[v.clienteNombre || 'General'] || 0) + safeNumber(v.valor || v.totalPagado);
      if (v.isAbono) return;
      (v.items || []).forEach(it =&gt; {
        const key = it.descripcion || 'Producto';
