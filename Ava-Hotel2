  addUnsub(db.collection('inventario').onSnapshot(invSnap =&gt; {
    inventoryProducts = invSnap.docs.map(doc =&gt; ({id:doc.id,...doc.data()})).filter(x =&gt; x.tipoProducto === 'Producto Venta');
    mergeInvoiceProducts();
  }));
  addUnsub(db.collection('productos').onSnapshot(prodSnap =&gt; {
    productPvpMap = {};
    prodSnap.forEach(doc =&gt; productPvpMap[doc.id] = doc.data());
    mergeInvoiceProducts();
  }));
  renderItems();
}

