        &lt;label for="companionName${companionCounter}"&gt;Nombre completo&lt;/label&gt;
        &lt;input id="companionName${companionCounter}" data-companion-name autocomplete="off" value="${escapeHtml(data.nombreCompleto || '')}" /&gt;
