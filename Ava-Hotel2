function metricCard(title, value, icon) {
  const display = typeof value === 'number' &amp;&amp; !['Stock total'].includes(title) ? money(value) : escapeHtml(value);
  return `&lt;div class="card metric-card"&gt;&lt;div&gt;&lt;div class="metric-title"&gt;${escapeHtml(title)}&lt;/div&gt;&lt;div class="metric-value"&gt;${display}&lt;/div&gt;&lt;/div&gt;&lt;div class="icon-bubble"&gt;&lt;i data-lucide="${icon}"&gt;&lt;/i&gt;&lt;/div&gt;&lt;/div&gt;`;
}

function simpleTable(title, headers, rows) {
  return `&lt;div class="card"&gt;&lt;h3&gt;${escapeHtml(title)}&lt;/h3&gt;${rows.length ? `&lt;div class="table-wrap"&gt;&lt;table&gt;&lt;thead&gt;&lt;tr&gt;${headers.map(h=&gt;`&lt;th&gt;${escapeHtml(h)}&lt;/th&gt;`).join('')}&lt;/tr&gt;&lt;/thead&gt;&lt;tbody&gt;${rows.map(r=&gt;`&lt;tr&gt;${r.map(c=&gt;`&lt;td&gt;${escapeHtml(c)}&lt;/td&gt;`).join('')}&lt;/tr&gt;`).join('')}&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;` : emptyState('Sin datos en el rango seleccionado.')}&lt;/div&gt;`;
}

