    if (!rooms.length) { $('#roomsGrid').innerHTML = `&lt;div class="card"&gt;${emptyState('No hay habitaciones creadas.')}&lt;/div&gt;`; initIcons(); return; }
    $('#roomsGrid').innerHTML = rooms.map(r =&gt; {
