function renderIngresoCompras() {
  let purchaseItems = [];
  let history = [];
  let nextNumber = 1;

  setContent(`
    ${sectionIntro('Ingreso de Compras', 'Registra compras por ítems bajo un mismo número correlativo.')}
    &lt;div class="card"&gt;
      &lt;div class="form-grid"&gt;
        &lt;div class="field"&gt;&lt;label&gt;N° de Compra&lt;/label&gt;&lt;input id="compraNumero" readonly value="Calculando..." /&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Tipo de Producto&lt;/label&gt;&lt;select id="tipoProducto"&gt;${PRODUCT_TYPES.map(t=&gt;`&lt;option&gt;${t}&lt;/option&gt;`).join('')}&lt;/select&gt;&lt;/div&gt;
        &lt;div class="field full"&gt;
          &lt;label&gt;Descripción del Producto&lt;/label&gt;
          &lt;input id="descripcionProducto" placeholder="Empieza a escribir para buscar en historial..." autocomplete="off" /&gt;
          &lt;div id="purchaseSuggest" class="suggestions"&gt;&lt;/div&gt;
        &lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Cantidad&lt;/label&gt;&lt;input id="cantidadCompra" type="number" min="0" step="0.01" /&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Tipo de Unidad&lt;/label&gt;&lt;select id="unidadCompra"&gt;${UNITS.map(u=&gt;`&lt;option&gt;${u}&lt;/option&gt;`).join('')}&lt;/select&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Valor Total ($)&lt;/label&gt;&lt;input id="valorTotalCompra" type="number" min="0" step="0.01" /&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Valor Unitario ($)&lt;/label&gt;&lt;input id="valorUnitarioCompra" readonly /&gt;&lt;/div&gt;
        &lt;div class="field"&gt;&lt;label&gt;Fecha y Hora&lt;/label&gt;&lt;input class="live-now" readonly /&gt;&lt;/div&gt;
      &lt;/div&gt;
      &lt;div id="existingProductNotice" class="notice hidden" style="margin-top:14px"&gt;&lt;/div&gt;
      &lt;div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:16px"&gt;
        &lt;button id="addPurchaseItem" class="btn btn-primary" type="button"&gt;&lt;i data-lucide="plus"&gt;&lt;/i&gt; Agregar ítem&lt;/button&gt;
        &lt;button id="savePurchase" class="btn btn-success" type="button"&gt;&lt;i data-lucide="save"&gt;&lt;/i&gt; Guardar compra&lt;/button&gt;
      &lt;/div&gt;
    &lt;/div&gt;
    &lt;div class="totalizer"&gt;&lt;span&gt;Total pre-compra&lt;/span&gt;&lt;strong id="purchaseStageTotal"&gt;${money(0)}&lt;/strong&gt;&lt;/div&gt;
    &lt;div class="card"&gt;&lt;div id="purchaseStageTable"&gt;&lt;/div&gt;&lt;/div&gt;
  `);
  setupLiveClock($('#content'));

  const recalcUnit = () =&gt; {
    const qty = safeNumber($('#cantidadCompra').value);
    const total = parseMoney($('#valorTotalCompra').value);
    $('#valorUnitarioCompra').value = qty &gt; 0 ? (total / qty).toFixed(2) : '';
  };
  $('#cantidadCompra').addEventListener('input', recalcUnit);
  $('#valorTotalCompra').addEventListener('input', recalcUnit);

  function getLatestByDesc(desc) {
    return history
      .filter(x =&gt; (x.descripcion || '').toLowerCase() === desc.toLowerCase())
      .sort((a,b) =&gt; (getDocDate(b) || 0) - (getDocDate(a) || 0))[0];
  }

  function updateNotice() {
    const desc = $('#descripcionProducto').value.trim();
    const latest = desc ? getLatestByDesc(desc) : null;
    const notice = $('#existingProductNotice');
    if (!latest) { notice.classList.add('hidden'); return; }
    notice.classList.remove('hidden');
    notice.innerHTML = `&lt;b&gt;Producto existente:&lt;/b&gt; se encontró en historial. Última unidad: &lt;b&gt;${escapeHtml(latest.tipoUnidad || '')}&lt;/b&gt; · Último costo unitario: &lt;b&gt;${money(latest.valorUnitario)}&lt;/b&gt;. Puedes actualizar el precio con esta compra y se propagará al inventario.`;
  }

  function resetForm() {
    $('#descripcionProducto').value='';
    $('#cantidadCompra').value='';
    $('#valorTotalCompra').value='';
    $('#valorUnitarioCompra').value='';
    $('#existingProductNotice').classList.add('hidden');
    $('#tipoProducto').value='Producto Venta';
    $('#unidadCompra').value='Und';
  }

  function renderStage() {
    $('#purchaseStageTotal').textContent = money(purchaseItems.reduce((sum,it)=&gt;sum+it.valorTotal,0));
    if (!purchaseItems.length) {
      $('#purchaseStageTable').innerHTML = emptyState('Agrega ítems antes de guardar la compra.');
      initIcons();
      return;
    }
    $('#purchaseStageTable').innerHTML = `
      &lt;div class="table-wrap"&gt;&lt;table&gt;
        &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Tipo&lt;/th&gt;&lt;th&gt;Descripción&lt;/th&gt;&lt;th&gt;Cantidad&lt;/th&gt;&lt;th&gt;Unidad&lt;/th&gt;&lt;th&gt;Total&lt;/th&gt;&lt;th&gt;Unitario&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
        &lt;tbody&gt;${purchaseItems.map((it,idx)=&gt;`
          &lt;tr&gt;
            &lt;td&gt;&lt;span class="pill"&gt;${escapeHtml(it.tipoProducto)}&lt;/span&gt;&lt;/td&gt;
            &lt;td&gt;${escapeHtml(it.descripcion)}&lt;/td&gt;
            &lt;td&gt;${it.cantidad}&lt;/td&gt;
            &lt;td&gt;${escapeHtml(it.tipoUnidad)}&lt;/td&gt;
            &lt;td class="amount"&gt;${money(it.valorTotal)}&lt;/td&gt;
            &lt;td class="amount"&gt;${money(it.valorUnitario)}&lt;/td&gt;
            &lt;td&gt;&lt;button class="btn btn-danger btn-sm" data-remove-purchase="${idx}" type="button"&gt;&lt;i data-lucide="trash-2"&gt;&lt;/i&gt; Eliminar&lt;/button&gt;&lt;/td&gt;
          &lt;/tr&gt;`).join('')}&lt;/tbody&gt;
      &lt;/table&gt;&lt;/div&gt;`;
    $$('[data-remove-purchase]').forEach(btn =&gt; btn.addEventListener('click', () =&gt; {
      purchaseItems.splice(Number(btn.dataset.removePurchase),1);
      renderStage();
    }));
    initIcons();
  }

  bindAutocomplete($('#descripcionProducto'), $('#purchaseSuggest'), () =&gt; history, x =&gt; x.descripcion || '', item =&gt; {
    $('#descripcionProducto').value = item.descripcion;
    $('#tipoProducto').value = item.tipoProducto || 'Producto Venta';
    $('#unidadCompra').value = item.tipoUnidad || 'Und';
    $('#valorUnitarioCompra').value = safeNumber(item.valorUnitario).toFixed(2);
    updateNotice();
  });

  $('#descripcionProducto').addEventListener('input', updateNotice);

  $('#addPurchaseItem').addEventListener('click', () =&gt; {
    const qty = safeNumber($('#cantidadCompra').value);
    const total = parseMoney($('#valorTotalCompra').value);
    const desc = $('#descripcionProducto').value.trim();
    if (!desc || qty &lt;= 0 || total &lt;= 0) {
      toast('Completa descripción, cantidad y valor total.', 'error'); return;
    }
    const item = {
      tipoProducto: $('#tipoProducto').value,
      descripcion: desc,
      cantidad: qty,
      tipoUnidad: $('#unidadCompra').value,
      valorTotal: total,
      valorUnitario: total / qty,
      productId: normalizeDocId(desc)
    };
    purchaseItems.push(item);
    resetForm();
    renderStage();
  });

  $('#savePurchase').addEventListener('click', async () =&gt; {
    if (!purchaseItems.length) { toast('No hay ítems para guardar.', 'error'); return; }
    try {
      const numero = nextNumber;
      const batch = db.batch();
      purchaseItems.forEach((it, idx) =&gt; {
        const ref = db.collection('compras').doc();
        batch.set(ref, { ...it, numeroCompra: numero, itemIndex: idx + 1, fecha: serverNow(), createdAt: serverNow(), creadoPor: currentUser.email });
        if (it.tipoProducto === 'Producto Venta') {
          const invRef = db.collection('inventario').doc(it.productId);
          batch.set(invRef, {
            tipoProducto: 'Producto Venta', descripcion: it.descripcion, tipoUnidad: it.tipoUnidad,
            stock: FV.increment(it.cantidad), costoUnitario: it.valorUnitario, updatedAt: serverNow()
          }, { merge:true });
          const prodRef = db.collection('productos').doc(it.productId);
          batch.set(prodRef, { nombre: it.descripcion, costoUnitario: it.valorUnitario, updatedAt: serverNow() }, { merge:true });
        }
      });
      await batch.commit();
      toast('Compra guardada');
      purchaseItems = [];
      resetForm();
      renderStage();
    } catch (err) { showError(err, 'No fue posible guardar la compra'); }
  });

  addUnsub(db.collection('compras').onSnapshot(snap =&gt; {
    history = snap.docs.map(doc =&gt; ({ id:doc.id, ...doc.data() }));
    const max = history.reduce((m,x)=&gt;Math.max(m, safeNumber(x.numeroCompra)), 0);
    nextNumber = max + 1;
    $('#compraNumero').value = nextNumber;
  }));
  renderStage();
}

