        toast('Producto eliminado de Inventario y Productos');
      } catch(err) { showError(err, 'No fue posible eliminar el producto'); }
    }));

    initIcons();
  };

  $('#inventorySearch').addEventListener('input', renderInventory);
  addUnsub(db.collection('inventario').onSnapshot(snap =&gt; {
    inventoryRows = snap.docs.map(doc =&gt; ({id:doc.id, ...doc.data()}))
      .filter(x =&gt; x.tipoProducto === 'Producto Venta')
      .sort((a,b)=&gt;(a.descripcion||'').localeCompare(b.descripcion||''));
    renderInventory();
  }));
}
// [MEJORA #1 - FIN]

/* =========================
   8. SECCIÓN: PRODUCTOS
   ========================= */
function renderProductos() {
  let inventory = [];
  let productDocs = {};
  let saveTimers = {};
  setContent(`${sectionIntro('Productos', 'Define PVP y controla márgenes desde el inventario.')}&lt;div class="card"&gt;&lt;div id="productsTable"&gt;&lt;/div&gt;&lt;/div&gt;`);

  const savePvp = async (id, value, rowEl) =&gt; {
    try {
      await db.collection('productos').doc(id).set({ pvp: safeNumber(value), updatedAt: serverNow() }, { merge:true });
      const check = rowEl?.querySelector('.check-save');
      if (check) { check.classList.add('show'); setTimeout(()=&gt;check.classList.remove('show'), 1200); }
    } catch(err) { showError(err, 'No fue posible guardar el PVP'); }
  };

  const render = () =&gt; {
    const rows = inventory.filter(x =&gt; x.tipoProducto === 'Producto Venta').sort((a,b)=&gt;(a.descripcion||'').localeCompare(b.descripcion||''));
    if (!rows.length) { $('#productsTable').innerHTML = emptyState('Los productos aparecen cuando existan en inventario.'); initIcons(); return; }
    $('#productsTable').innerHTML = `&lt;div class="table-wrap"&gt;&lt;table&gt;
      &lt;thead&gt;&lt;tr&gt;&lt;th&gt;Nombre del Producto&lt;/th&gt;&lt;th&gt;Costo Unitario&lt;/th&gt;&lt;th&gt;PVP&lt;/th&gt;&lt;th&gt;Margen $&lt;/th&gt;&lt;th&gt;Margen %&lt;/th&gt;&lt;th&gt;&lt;/th&gt;&lt;/tr&gt;&lt;/thead&gt;
      &lt;tbody&gt;${rows.map(r=&gt;{
        const prod = productDocs[r.id] || {};
        const costo = safeNumber(r.costoUnitario);
        const pvp = safeNumber(prod.pvp);
        const margen = pvp - costo;
        // MEJORA #5
        const pct = pvp &gt; 0 ? ((pvp - costo) / pvp) * 100 : 0;
        return `&lt;tr data-product-row="${r.id}"&gt;
          &lt;td&gt;${escapeHtml(r.descripcion)}&lt;/td&gt;
          &lt;td class="amount"&gt;${money(costo)}&lt;/td&gt;
          &lt;td&gt;&lt;div style="display:flex;align-items:center;gap:8px"&gt;&lt;input class="pvp-input" data-id="${r.id}" data-costo="${costo}" value="${pvp || ''}" type="number" min="0" step="0.01" placeholder="0" style="max-width:160px" /&gt;&lt;span class="check-save"&gt;✓&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;
          &lt;td class="amount margin-money"&gt;${money(margen)}&lt;/td&gt;
          &lt;td class="amount margin-pct"&gt;${pct.toFixed(2)}%&lt;/td&gt;
          &lt;td&gt;&lt;button class="btn btn-danger btn-sm" data-delete-product="${r.id}" type="button"&gt;&lt;i data-lucide="trash-2"&gt;&lt;/i&gt; Eliminar&lt;/button&gt;&lt;/td&gt;
        &lt;/tr&gt;`;
      }).join('')}&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;`;
    $$('.pvp-input').forEach(input =&gt; {
      const row = input.closest('tr');
      const updateMargins = () =&gt; {
        const pvp = safeNumber(input.value);
        const costo = safeNumber(input.dataset.costo);
        const margen = pvp - costo;
        row.querySelector('.margin-money').textContent = money(margen);
        // MEJORA #5
        row.querySelector('.margin-pct').textContent = pvp &gt; 0 ? (((pvp - costo) / pvp) * 100).toFixed(2) + '%' : '0.00%';
      };
      input.addEventListener('input', () =&gt; {
        updateMargins();
        clearTimeout(saveTimers[input.dataset.id]);
        saveTimers[input.dataset.id] = setTimeout(() =&gt; savePvp(input.dataset.id, input.value, row), 800);
      });
      input.addEventListener('blur', () =&gt; savePvp(input.dataset.id, input.value, row));
    });

    // MEJORA #4
    $$('[data-delete-product]').forEach(btn =&gt; btn.addEventListener('click', async () =&gt; {
      const row = rows.find(r =&gt; r.id === btn.dataset.deleteProduct);
      if (!row) return;
      if (!confirm(`¿Eliminar "${row.descripcion}" de Productos e Inventario?`)) return;
      try {
        await deleteProductFromActiveCollections(row.id, row.descripcion);
        toast('Producto eliminado de Productos e Inventario');
      } catch(err) { showError(err, 'No fue posible eliminar el producto'); }
    }));
    initIcons();
  };

  addUnsub(db.collection('inventario').onSnapshot(snap =&gt; { inventory = snap.docs.map(doc =&gt; ({ id:doc.id, ...doc.data() })); render(); }));
  addUnsub(db.collection('productos').onSnapshot(snap =&gt; { productDocs = {}; snap.forEach(doc =&gt; productDocs[doc.id] = doc.data()); render(); }));
}

