  }

  function renderCharts(barValues, paymentMap, projection, goal) {
    Object.values(chartInstances).forEach(ch =&gt; { try { ch.destroy(); } catch(e){} });
    chartInstances = {};
    const barCtx = $('#barChart');
    const doughnutCtx = $('#paymentChart');
    const lineCtx = $('#projectionChart');
    if (barCtx) chartInstances.bar = new Chart(barCtx, { type:'bar', data:{ labels:['Ventas','Compras','Gastos'], datasets:[{ label:'Valor', data:barValues }] }, options:{ responsive:true, plugins:{ legend:{display:false} } } });
