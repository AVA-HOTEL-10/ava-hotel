    const totalValue = inventoryRows.reduce((s,r)=&gt;s+(safeNumber(r.stock)*safeNumber(r.costoUnitario)),0);

    if (!inventoryRows.length) {
      $('#inventoryTable').innerHTML = emptyState('Todavía no hay productos de venta en inventario.');
