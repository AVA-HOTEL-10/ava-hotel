function bindAutocomplete(input, box, itemsSource, getText, onSelect) {
  const render = () =&gt; {
    const q = input.value.trim().toLowerCase();
    if (!q) { box.classList.remove('show'); box.innerHTML=''; return; }
    const items = typeof itemsSource === 'function' ? itemsSource() : itemsSource;
    const seen = new Set();
    const matches = (items || [])
      .filter(item =&gt; getText(item).toLowerCase().includes(q))
      .filter(item =&gt; {
        const k = getText(item).toLowerCase();
        if (seen.has(k)) return false;
        seen.add(k);
        return true;
      })
      .slice(0, 9);
    box.innerHTML = matches.map((item, idx) =&gt; `&lt;div class="suggestion-item" data-idx="${idx}"&gt;${escapeHtml(getText(item))}&lt;/div&gt;`).join('');
    box.classList.toggle('show', matches.length &gt; 0);
    $$('.suggestion-item', box).forEach(el =&gt; {
      el.addEventListener('mousedown', ev =&gt; {
        ev.preventDefault();
        const item = matches[Number(el.dataset.idx)];
        onSelect(item);
        box.classList.remove('show');
      });
    });
  };
  input.addEventListener('input', render);
  input.addEventListener('focus', render);
  input.addEventListener('blur', () =&gt; setTimeout(() =&gt; box.classList.remove('show'), 120));
}

