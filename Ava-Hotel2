  const render = () =&gt; {
    const start = $('#filterStart').value;
    const end = $('#filterEnd').value;
    const ventasF = ventas.filter(v =&gt; inDateRange(v,start,end));
    const comprasF = compras.filter(c =&gt; inDateRange(c,start,end));
    const gastosF = gastos.filter(g =&gt; inDateRange(g,start,end));
    const registrosF = registros.filter(r =&gt; inDateRange(r,start,end));

    const totalVentas = ventasF.reduce((s,v)=&gt;s+safeNumber(v.valor || v.totalPagado),0);
    const totalCompras = comprasF.reduce((s,c)=&gt;s+safeNumber(c.valorTotal),0);
    const totalGastos = gastosF.reduce((s,g)=&gt;s+safeNumber(g.valor),0);
    // [MEJORA #3 - INICIO]
    const ingresosServicios = registrosF.reduce((s,r)=&gt;s+safeNumber(r.valor || r.valorPagado),0);
    const utilidad = ingresosServicios + totalVentas - totalCompras - totalGastos;
    const goal = safeNumber(metaDoc.metaMensual || metaDoc.valor || 0);
    const goalBase = ingresosServicios + totalVentas;
    // [MEJORA #3 - FIN]
    const pctGoal = goal &gt; 0 ? Math.min((goalBase / goal) * 100, 999) : 0;
    $('#monthlyGoal').value = goal || '';
    $('#goalProgress').style.width = Math.min(pctGoal,100).toFixed(2) + '%';
