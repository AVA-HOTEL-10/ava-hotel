    updateRoomVisibility();
  };

  const calc = () =&gt; {
    const service = getSelectedService();
    $('#guestValue').value = service ? safeNumber(service.valor).toFixed(2) : '';
    const total = service ? safeNumber(service.valor) : 0;
    const received1 = $('#guestReceived1').value === '' ? 0 : safeNumber($('#guestReceived1').value);
    const received2 = $('#guestSplit').checked ? safeNumber($('#guestReceived2').value) : 0;
    const diff = received1 + received2 - total;
    $('#guestChange').value = diff &gt;= 0 ? `Devuelve ${money(diff)}` : `Pendiente ${money(Math.abs(diff))}`;
    updateRoomVisibility();
  };

  $('#guestService').addEventListener('change', calc);
  ['guestReceived1','guestReceived2'].forEach(id =&gt; $('#' + id).addEventListener('input', calc));
  $('#guestSplit').addEventListener('change', () =&gt; { $$('.split-guest').forEach(el=&gt;el.classList.toggle('hidden', !$('#guestSplit').checked)); calc(); });

  bindAutocomplete($('#guestName'), $('#guestSuggest'), () =&gt; clients, x =&gt; x.nombre || '', c =&gt; { selectedClient = c; $('#guestName').value = c.nombre; $('#guestCedula').value = c.cedula || ''; });

  $('#saveGuest').addEventListener('click', async () =&gt; {
    const service = getSelectedService();
    const requiresRoom = service ? service.requiereHabitacion !== false : true;
    const room = requiresRoom ? rooms.find(r =&gt; r.id === $('#guestRoom').value) : null;
    const clienteNombre = $('#guestName').value.trim();

    if (!clienteNombre || !service || (requiresRoom &amp;&amp; !room)) {
      toast(requiresRoom ? 'Completa cliente, servicio y habitación.' : 'Completa cliente y servicio.', 'error');
      return;
    }

    // MEJORA ACOMPAÑANTES
    const companionData = collectCompanions();
    if (!companionData.valid) {
      toast('Completa el nombre y la cédula de cada acompañante, o elimina las filas vacías.', 'error');
      return;
    }
    const acompanantes = companionData.acompanantes;

    try {
      const total = safeNumber(service.valor);
      const amount1 = $('#guestReceived1').value === '' ? 0 : safeNumber($('#guestReceived1').value);
      const amount2 = $('#guestSplit').checked ? safeNumber($('#guestReceived2').value) : 0;
      const received = amount1 + amount2;
      const paid = Math.min(received, total);
      const debt = Math.max(total - received, 0);
      const payments = getPaymentDistribution($('#guestPayment1').value, amount1, $('#guestSplit').checked, $('#guestPayment2').value, amount2);
      const exit = requiresRoom ? calculateExitDate(service, new Date()) : null;
      if (requiresRoom &amp;&amp; !exit) throw new Error('No fue posible calcular la hora de salida del servicio seleccionado.');

      const batch = db.batch();
      let registroRef = null;
      if (paid &gt; 0) {
        registroRef = db.collection('registros').doc();
        batch.set(registroRef, {
          clienteNombre, clienteId: selectedClient?.id || null, cedula: $('#guestCedula').value.trim(),
          // MEJORA ACOMPAÑANTES
          acompanantes,
          servicioId: service.id, servicioDescripcion: service.descripcion,
          requiereHabitacion: requiresRoom,
          habitacionId: requiresRoom ? room.id : null,
          habitacionNombre: requiresRoom ? room.nombre : null,
          valorTotal: total, valorPagado: paid, valor: paid, saldoPendiente: debt,
          formaPago: $('#guestPayment1').value, pagoDividido: $('#guestSplit').checked, pagos: payments,
          fecha: serverNow(), createdAt: serverNow(), origen: requiresRoom ? 'hospedaje' : 'servicio', creadoPor: currentUser.email
        });
      }

      // MEJORA ACOMPAÑANTES: no se agrega el array a Cartera; la deuda pertenece solo al titular.
      if (debt &gt; 0 || received &lt;= 0) {
        const debtRef = db.collection('cartera').doc();
        batch.set(debtRef, {
          clienteNombre, clienteId: selectedClient?.id || null, cedula: $('#guestCedula').value.trim(), descripcion: service.descripcion,
          valorPendiente: debt &gt; 0 ? debt : total, valorOriginal: total,
          origen: requiresRoom ? 'hospedaje' : 'servicio', servicioId: service.id,
          requiereHabitacion: requiresRoom,
          habitacionId: requiresRoom ? room.id : null,
          habitacionNombre: requiresRoom ? room.nombre : null,
          fecha: serverNow(), createdAt: serverNow()
        });
      }

      if (requiresRoom) {
        const roomRef = db.collection('habitaciones').doc(room.id);
        batch.set(roomRef, {
          estado:'ocupada', updatedAt: serverNow(),
          estadiaActiva: {
            clienteNombre, clienteId: selectedClient?.id || null, cedula: $('#guestCedula').value.trim(), servicioId: service.id,
            // MEJORA ACOMPAÑANTES
            acompanantes,
            servicioDescripcion: service.descripcion, valor: total, checkIn: serverNow(), expiresAt: firebase.firestore.Timestamp.fromDate(exit),
            tipoTiempo: service.tipoTiempo, horas: service.horas || null, horaSalida: service.horaSalida || null, registroId: registroRef?.id || null
          }
        }, { merge:true });
      }

      await batch.commit();
      toast(requiresRoom ? 'Registro guardado y habitación ocupada' : 'Servicio registrado sin habitación');
      selectedClient = null;
      $('#guestName').value='';
      $('#guestCedula').value='';
      $('#guestService').value='';
      $('#guestRoom').value='';
      $('#guestReceived1').value='';
      $('#guestReceived2').value='';
      $('#guestSplit').checked=false;
      $$('.split-guest').forEach(el=&gt;el.classList.add('hidden'));

      // MEJORA ACOMPAÑANTES
      $('#guestHasCompanions').checked = false;
      $('#guestCompanionsPanel').classList.add('hidden');
      companionsList.innerHTML = '';
      companionCounter = 0;

      calc();
    } catch(err) { showError(err, 'No fue posible guardar el registro'); }
  });

  addUnsub(db.collection('clientes').onSnapshot(snap =&gt; { clients = snap.docs.map(doc =&gt; ({id:doc.id,...doc.data()})); }));
  addUnsub(db.collection('servicios').onSnapshot(snap =&gt; { services = snap.docs.map(doc =&gt; ({id:doc.id,...doc.data()})); updateSelects(); calc(); }));
  addUnsub(db.collection('habitaciones').onSnapshot(snap =&gt; { rooms = snap.docs.map(doc =&gt; ({id:doc.id,...doc.data()})); updateSelects(); }));
  updateSelects();
}
