        ${r.estado === 'libre' ? `&lt;button class="btn btn-danger btn-sm" data-delete-room="${r.id}" style="margin-top:14px" type="button"&gt;&lt;i data-lucide="trash-2"&gt;&lt;/i&gt; Eliminar&lt;/button&gt;` : ''}
      &lt;/div&gt;`;
    }).join('');
    $$('.room-card').forEach(card =&gt; card.addEventListener('click', ev =&gt; {
      if (ev.target.closest('[data-delete-room]')) return;
      const r = rooms.find(x =&gt; x.id === card.dataset.room);
      if (r?.estado === 'ocupada') openRoomPanel(r);
    }));
    $$('[data-delete-room]').forEach(btn =&gt; btn.addEventListener('click', async ev =&gt; {
      ev.stopPropagation();
      if (!confirmPassword()) { toast('Contraseña incorrecta.', 'error'); return; }
      try { await db.collection('habitaciones').doc(btn.dataset.deleteRoom).delete(); toast('Habitación eliminada'); }
      catch(err) { showError(err, 'No fue posible eliminar'); }
    }));
    initIcons();
  }
  addUnsub(db.collection('habitaciones').onSnapshot(snap =&gt; { rooms = snap.docs.map(doc =&gt; ({id:doc.id,...doc.data()})).sort((a,b)=&gt;(a.nombre||'').localeCompare(b.nombre||'', undefined, {numeric:true})); renderRooms(); }));
  const interval = setInterval(renderRooms, 30000); activeIntervals.push(interval);
}

